{
  "routes": [
    {
      "src": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Cc]url|[Ww]get|[Hh][Tt][Tt][Pp]ie|lwp-request|python-requests).*"
        }
      ],
      "dest": "/llms.txt"
    },
    {
      "src": "/resume",
      "dest": "/resume.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
